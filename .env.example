# ==============================================================================
# Job Butler - Environment Configuration
# ==============================================================================

# Candidate Masked Personal Details (Dynamically injected into candidate_profile.yaml)
CANDIDATE_PHONE="+91 00000 00000"
CANDIDATE_CITY="Delhi"
CANDIDATE_STATE="Delhi NCR"
CANDIDATE_POSTAL_CODE="110001"
CANDIDATE_EMAIL="you@example.com"

# External API Keys
FIRECRAWL_API_KEY="fc-your-firecrawl-key"
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Application Runtime
APP_ENV="local"
DEBUG="true"
PORT="8000"
FRONTEND_PORT="3000" # Local Next.js dev server only (make dev-frontend); production serves UI on PORT
DATABASE_URL="sqlite:///./data/job_butler.db"

